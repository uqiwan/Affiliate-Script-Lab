rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow get, create, update, delete: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      match /settings/{settingId} {
        allow get, create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isOwner(userId) && isValidId(userId);
      }

      match /history/{sessionId} {
        allow get, create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
