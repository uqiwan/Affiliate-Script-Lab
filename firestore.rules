rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
      }

      match /history/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
