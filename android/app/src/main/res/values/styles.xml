<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#F59E0B</item>
        <item name="colorPrimaryDark">#D97706</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionModeTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionModeBackground">@color/action_mode_background</item>
        <item name="actionModeSplitBackground">@color/action_mode_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionModeTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="actionModeBackground">@color/action_mode_background</item>
        <item name="actionModeSplitBackground">@color/action_mode_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#F2F2F7</item>
    </style>
</resources>
